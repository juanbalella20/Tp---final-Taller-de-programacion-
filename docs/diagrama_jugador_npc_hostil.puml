@startuml jugador_npc_hostil
title Diagrama de clases: Jugador y NPC hostil

skinparam classAttributeIconSize 0
skinparam linetype ortho

' ===================== Base comun =====================

struct DamageOutcome {
    + damage : int
    + gold_drop : int
    + dodged : bool
    + level_up : bool
    + dropped_item : unique_ptr<Item>
}

abstract class Entity {
    + {abstract} get_name() : string
    + {abstract} receive_damage(damage : int, atacante : Player&, is_critical : bool) : DamageOutcome
    + {abstract} is_dead() : bool
}

class NPC {
    # npc_id : int
    # name : string
    + {static} set_npc_id(npc_id : int) : void
    + {static} set_npc_name(npc_name : string) : void
}

' ===================== Jugador =====================

class Player {
    - name : string
    - gold : uint32_t
    - lives : uint32_t
    - experience : uint32_t
    - mana : uint32_t
    - coord_x : int
    - coord_y : int
    - state : unique_ptr<PlayerState>
    - equipped_item : shared_ptr<Item>
    - player_race : PlayerRace
    - player_class : PlayerClass
    - player_inventory : Inventory
    - defense_set : DefenseSet
    - level : Level
    - inmortal : bool
    - inf_mana : bool
    --
    - max_life() : uint32_t
    - max_mana() : uint32_t
    - to_ghost() : void
    - to_alive() : void
    - to_meditate() : void
    + add_item(item : unique_ptr<Item>) : void
    + drop_item(item : Item*) : void
    + drop_inventory() : vector<unique_ptr<Item>>
    + equip_item(item_uid : uint64_t) : void
    + calculate_defense() : int
    + attack(target : Entity&, target_x : int, target_y : int) : DamageOutcome
    + cast_on_self() : void
    + use_consumable(item_uid : uint64_t) : bool
    + ganar_xp(dano : int, nivel_target : int, murio : bool, vida_max_target : int) : bool
    + revive() : void
    + heal(healthy_life : int, healthy_mana : int) : void
    + regen_life(percent : double) : bool
    + regen_mana(percent : double) : bool
    + toggle_meditation() : bool
    + stop_meditation() : void
    + recover_meditation_mana(seconds : double) : void
    + tick(seconds : double) : bool
    + update_position(x : int, y : int) : void
    + receive_damage(damage : int, atacante : Player&, is_critical : bool) : DamageOutcome <<override>>
    + receive_npc_damage(damage : int, is_critical : bool) : DamageOutcome
    + damage_attack() : int
    + check_level_up() : bool
    + restore(gold, lives, mana, experience, level) : void
}

class PlayerRace {
    - inteligence : int
    - agility : int
    - strength : int
    - endurance : float
    - life_factor : float
    - mana_factor : float
    - name : string
    - race_id : RaceType
    + {static} from_name(name : string) : PlayerRace
    + get_race_id() : RaceType
    + race_constitution() : float
}

class PlayerClass {
    - inteligence : int
    - agility : int
    - strength : int
    - endurance : int
    - life_factor : float
    - mana_factor : float
    - meditation_factor : float
    - class_id : ClassType
    + {static} from_name(name : string) : PlayerClass
    + get_class_id() : ClassType
    + class_can_meditate() : bool
}

class Inventory {
    - items : vector<unique_ptr<Item>>
    - equipped_item : Item*
    + add_item(item : unique_ptr<Item>) : bool
    + drop_item(item : Item*) : unique_ptr<Item>
    + equip_item(item_uid : uint64_t) : void
    + has_weapon_equipped() : bool
    + is_full() : bool
}

class DefenseSet {
    - armadura : DefenseItem*
    - casco : DefenseItem*
    - escudo : DefenseItem*
    + equip_armadura(item : DefenseItem*) : void
    + equip_casco(item : DefenseItem*) : void
    + equip_escudo(item : DefenseItem*) : void
    + unequip_armadura() : void
    + unequip_casco() : void
    + unequip_escudo() : void
    + is_equipped(item_uid : uint64_t) : bool
    + calculate_defense() : int
    + clear() : void
}

class Level {
    - number : int
    - max_gold() : uint32_t
    + Level(number : int)
    + try_level_up(experience : uint32_t) : bool
    + calculate_gold_drop(gold : uint32_t) : uint32_t
    + xp_per_attack(damage : int, target_level : int) : int
    + xp_per_kill(target_max_life : int, target_level : int) : int
    + is_newbie() : bool
    + can_attack_level(other_level : int) : bool
    + max_xp() : uint32_t
}

abstract class PlayerState {
    + {abstract} attack(self : Player&, target : Entity&, target_x : int, target_y : int) : DamageOutcome
    + {abstract} receive_damage(self : Player&, damage : int, attacker : Player&, is_critical : bool) : DamageOutcome
    + {abstract} receive_npc_damage(self : Player&, damage : int, is_critical : bool) : DamageOutcome
    + {abstract} revive(self : Player&) : void
    + {abstract} is_ghost() : bool
    + {abstract} can_interact() : bool
    + tick(self : Player&, seconds : double) : bool
    + stop_meditation(self : Player&) : void
    + {abstract} toggle_meditation(self : Player&) : bool
}

' ===================== NPC hostil =====================

enum State {
    DEAD
    ALIVE
}

class NPChostile {
    - type_id : string
    - lifepoints : int
    - attack_dmg : int
    - state : State
    - coord_x : int
    - coord_y : int
    - remaining_ticks_to_spawn : int
    - ticks_to_spawn : int
    - max_lifepoints : int
    - level : LevelHostile
    - current_direction : Direction
    - target_player : string
    - attack_speed_ticks : int
    - current_attack_cooldown : int
    --
    - death() : void
    - set_state(state : State) : void
    - drop() : int
    - roll_extra_gold() : int
    + NPChostile(type_id, name, lifepoints, attack_dmg, ticks_to_spawn, level)
    + receive_damage(damage : int, atacante : Player&, is_critical : bool) : DamageOutcome <<override>>
    + is_dead() : bool <<override>>
    + can_spawn() : bool
    + reduce_ticks_to_spawn() : void
    + revive(x : int, y : int) : void
    + move_towards(target_x, target_y, world : ZoneWorld&, players : vector<Player*>&) : void
    + can_attack() : bool
    + reset_attack_cooldown() : void
    + tick_cooldowns() : void
    + clear_target() : void
}

class LevelHostile {
    - level : int
    + LevelHostile(level : int)
    + get_level() : int
    + calculateDamage(damage : int) : int
    + calculateLife(life : int) : int
}

' ===================== Relaciones =====================

Entity ..> DamageOutcome : produce

Player --|> Entity
NPChostile --|> NPC
NPChostile --|> Entity

' Composicion del jugador
Player *-- "1" PlayerRace
Player *-- "1" PlayerClass
Player *-- "1" Inventory
Player *-- "1" DefenseSet
Player *-- "1" Level
Player *-- "1" PlayerState

' Composicion del NPC hostil
NPChostile *-- "1" LevelHostile
NPChostile ..> State : usa

' Interacciones de combate
Player ..> NPChostile : ataca / recibe daño
NPChostile ..> Player : persigue / ataca

@enduml
